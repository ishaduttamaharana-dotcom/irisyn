# IRISYN Phase 7 Production Environment Configuration Template
NODE_ENV=production
APP_URL=http://localhost:5173
API_URL=http://localhost:8080/api
WEBSOCKET_URL=ws://localhost:8080/ws/telemetry

# Database Persistence
DATABASE_URL=jdbc:postgresql://localhost:5432/digital_twin
DATABASE_USERNAME=twinuser
DATABASE_PASSWORD=twinpassword

# Security & Authentication
AUTH_SECRET=irisyn_production_jwt_signing_secret_key_32bytes_min

# AI & Copilot Engine Configuration
LLM_PROVIDER=LOCAL
LLM_MODEL=Granite-7b-Lab
LLM_API_KEY=sk-demo-key-for-local-provider

# Observability & System Features
LOG_LEVEL=INFO
ENABLE_SIMULATION=true
ENABLE_COPILOT=true
