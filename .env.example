# IRISYN Platform Environment Configuration Example
# Copy to .env for local runtime configuration. DO NOT commit actual secrets.

NODE_ENV=development

# LLM Provider Abstraction Configuration (Backend-Only)
LLM_PROVIDER=LOCAL
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_api_key_here

# Database & Authentication Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/digital_twin
AUTH_SECRET=your_jwt_auth_secret_here

# Copilot Service Base URL
COPILOT_BASE_URL=http://localhost:8080/api/copilot
